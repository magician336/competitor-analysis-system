ub.com/repos/Trae-AI/TRAE/issues/comments/2965593463/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Trae-AI/TRAE/issues/comments/2987849605","html_url":"https://github.com/Trae-AI/TRAE/issues/996#issuecomment-2987849605","issue_url":"https://api.github.com/repos/Trae-AI/TRAE/issues/996","id":2987849605,"node_id":"IC_kwDONiYvnc6yFveF","user":{"login":"qinfeng0214","id":51642121,"node_id":"MDQ6VXNlcjUxNjQyMTIx","avatar_url":"https://avatars.githubusercontent.com/u/51642121?v=4","gravatar_id":"","url":"https://api.github.com/users/qinfeng0214","html_url":"https://github.com/qinfeng0214","followers_url":"https://api.github.com/users/qinfeng0214/followers","following_url":"https://api.github.com/users/qinfeng0214/following{/other_user}","gists_url":"https://api.github.com/users/qinfeng0214/gists{/gist_id}","starred_url":"https://api.github.com/users/qinfeng0214/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qinfeng0214/subscriptions","organizations_url":"https://api.github.com/users/qinfeng0214/orgs","repos_url":"https://api.github.com/users/qinfeng0214/repos","events_url":"https://api.github.com/users/qinfeng0214/events{/privacy}","received_events_url":"https://api.github.com/users/qinfeng0214/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-19T12:05:33Z","updated_at":"2025-06-19T12:05:33Z","body":"> 这个问题不是trae的问题。跟MCP服务有关。当MCP服务器以服务形式运行时，它默认使用的/bin/sh环境可能不会加载用户shell配置文件(如.bashrc、.zshrc或.config/fish/config.fish)，导致无法识别nvm设置的PATH。可在shell终端中，通过命令open -a 'path/to/your/Trae CN.app'（mac电脑），就可以了。\n\n如您所说，我做了如下尝试，并重启 Trae，但依然提示失败\nwhich Trae\n/usr/local/bin/Trae\nopen -a '/usr/local/bin/Trae'","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Trae-AI/TRAE/issues/comments/2987849605/reactions","total_count":0,"+1":0,"-1":