ssues/comments/3788603874/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Trae-AI/TRAE/issues/comments/3788620026","html_url":"https://github.com/Trae-AI/TRAE/issues/2065#issuecomment-3788620026","issue_url":"https://api.github.com/repos/Trae-AI/TRAE/issues/2065","id":3788620026,"node_id":"IC_kwDONiYvnc7h0cD6","user":{"login":"bytemain","id":13938334,"node_id":"MDQ6VXNlcjEzOTM4MzM0","avatar_url":"https://avatars.githubusercontent.com/u/13938334?v=4","gravatar_id":"","url":"https://api.github.com/users/bytemain","html_url":"https://github.com/bytemain","followers_url":"https://api.github.com/users/bytemain/followers","following_url":"https://api.github.com/users/bytemain/following{/other_user}","gists_url":"https://api.github.com/users/bytemain/gists{/gist_id}","starred_url":"https://api.github.com/users/bytemain/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bytemain/subscriptions","organizations_url":"https://api.github.com/users/bytemain/orgs","repos_url":"https://api.github.com/users/bytemain/repos","events_url":"https://api.github.com/users/bytemain/events{/privacy}","received_events_url":"https://api.github.com/users/bytemain/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-23T06:56:24Z","updated_at":"2026-01-23T06:56:24Z","body":"我来跟进下这个问题，各位可以给我的邮箱发个联系方式，我联系你们进行排查 \n邮箱地址（base64 格式）：\namlhY2hlbmcubGlAYnl0ZWRhbmNlLmNvbQ== ","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Trae-AI/TRAE/issues/comments/3788620026/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Trae-AI/TRAE/issues/comments/3815772898","html_url":"https://github.com/Trae-AI/TRAE/issues/2065#issuecomment-3815772898","issue_url":"https://api.github.com/repos/Trae-AI/TRAE/issues/2065","id":3815772898,"node_id":"IC_kwDONiYvnc7jcBLi","user":{"login":"bytemain","id":13938334,"node_id":"MDQ6VXNlcjEzOTM4MzM0","avatar_url":"https://avatars.githubusercontent.com/u/13938334?v=4","gravatar_id":"","url":"https://api.github.com/users/bytemain","html_url":"https://github.com/bytemain","followers_url":"https://api.github.com/users/bytemain/followers","following_url":"https://api.github.com/users/bytemain/following{/other_user}","gists_url":"https://api.github.com/users/bytemain/gists{/gist_id}","starred_url":"https://api.github.com/users/bytemain/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bytemain/subscriptions","organizations_url":"https://api.github.com/users/bytemain/orgs","repos_url":"https://api.github.com/users/bytemain/repos","events_url":"https://api.github.com/users/bytemain/events{/privacy}","received_events_url":"https://api.github.com/users/bytemain/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-29T06:36:52Z","updated_at":"2026-03-09T04:19:03Z","body":"排查指南\n\n## 网络问题\n如果遇到此问题可以执行下 `curl -vvv https://coresg-normal.trae.ai/api/ide/v1/ping` 看能不能 ping 通我们的海外版服务器：\n\n<img width=\"1382\" height=\"428\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/c696c6da-d46a-4539-a1ee-6000a71159fd\" />\n\n如果遇到像上图这样的报错，可能要在 clash 等代理软件中加一下全局代理的配置。\n\n也可以尝试 kill 掉所有的代理软件后再尝试一下：\n```sh\nsudo pkill -f \"clash|mihomo|cfw\"\n```\n\n## 终端问题\n\n还有就是请确认下终端能否启动，如果终端无法启动的话 AI 也会请求失败。\n\n## 环境兼容性问题\n\n各位也可以按这个方案排查下是不是 GLIBC 的问题：\n\n### 1. 一键排查命令\n\n在 **Linux 服务器** 上执行以下命令，检测是否存在 `libstdc++` 版本冲突：\n\n```bash\ngrep -r \"version \\`GLIBCXX_.*' not found\" ~/.trae-server/manager-logs/\n```\n\n#### 结果判断：\n\n- **如果有输出**（类似于下面的内容），则**确认命中**该问题：\n  ```text\n  .../libstdc++.so.6: version `GLIBCXX_3.4.30' not found (required by /etc/thunder/libthunder.so)\n  ```\n- **如果没有输出**，则可能是其他连接问题。\n\n---\n\n### 2. 问题现象\n\n- AI 面板无法聊天。\n- 服务器端存在全局注入的动态库（如安全软件、监控组件，例如 `/etc/thunder/libthunder.so`）。\n\n### 3. 根本原因\n\nTRAE Server 为了保证在老旧系统上的兼容性，自带了一个较旧版本的 `libstdc++.so.6`。\n当系统环境中有程序（或被强制注入的库）是用新版编译器编译的，依赖了新版 `GLIBCXX` 符号时，Trae 自带的旧库无法满足需求，导致加载失败。\n\n## 4. 解决方案\n\n### 步骤 1：找到 TRAE Server 的安装目录\n\n通常在 `~/.trae-server/bin/stable-<commit-id>-debian10/` 下。可以从报错日志中提取准确路径。\n\n### 步骤 2：重命名自带的 `libstdc++.so.6`\n\n进入 `lib/trae-helper` 目录（或者报错日志中指示的包含 `libstdc++.so.6` 的目录），将自带的库文件重命名。\n\n```bash\n# 示例路径，请根据实际 grep 出来的日志路径调整\ncd ~/.trae-server/bin/stable-*-debian10/lib/trae-helper/\n\n# 备份并重命名，迫使程序使用系统的 libstdc++.so.6\nmv libstdc++.so.6 libstdc++.so.6.bak\n```\n\n#### 步骤 3：重启服务\n\n整个退出本地 TRAE IDE，重新连接远程服务器即可。\n","author_association":"COLLABORATOR","pin":{"pinned_by":{"login":"bytemain","id":13938334,"node_id":"MDQ6VXNlcjEzOTM4MzM0","avatar_url":"https://avatars.githubusercontent.com/u/13938334?v=4","gravatar_id":"","url":"https://api.github.com/users/bytemain","html_url":"https://github.com/bytemain","followers_url":"https://api.github.com/users/bytemain/followers","following_url":"https://api.github.com/users/bytemain/following{/other_user}","gists_url":"https://api.github.com/users/bytemain/gists{/gist_id}","starred_url":"https://api.github.com/users/bytemain/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bytemain/subscriptions","organizations_url":"https://api.github.com/users/bytemain/orgs","repos_url":"https://api.github.com/users/bytemain/repos","events_url":"https://api.github.com/users/bytemain/events{/privacy}","received_events_url":"https://api.github.com/users/bytemain/received_events","type":"User","user_view_type":"public","site_admin":false},"pinned_at":"2026-03-02T11:40:57Z"},"reactions":{"url":"https://api.github.com/repos/Trae-AI/TRAE/issues/comments/3815772898/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.