d](https://dev.azure.com/monacotools/Monaco/_build/results?buildId=403567&view=logs).</details>","reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-chat/releases/283933334/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0}}}