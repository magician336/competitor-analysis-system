public","site_admin":true},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Problem\n`.instructions.md` files, designed to provide custom instructions for AI chat and agent functionalities, are not being respected or applied in both VS Code stable and insider builds. This issue prevents users from leveraging predefined instructions for specific tasks, programming languages, frameworks, or project types, leading to repetitive manual instruction input and a degraded user experience for AI-assisted development.\n\nI am trying below example but it's not working.\n\n```markdown\n---\napplyTo: \"**/*.md\"\n---\n\n## Follow below things for Markdown Files\n\n1. Do not use markdown bold (**) and italic (_) formatting in the markdown file. Use only headings, lists, and code blocks.\n2. Also add markdown divider --- after each heading like # or ## or ###.\n```\n\n## Solution\nInvestigate and resolve the bug preventing VS Code's chat and agent features from correctly parsing and applying instructions defined in `.instructions.md` files. This includes ensuring proper recognition of both workspace and user instruction files, correct interpretation of `applyTo` metadata, and consistent application of instruction content across all relevant AI interactions.\n\n## Benefits\n* **Enhanced Productivity:** Users can automate the inclusion of custom AI instructions, saving time and effort.\n* **Consistent AI Behavior:** Ensures AI agents and chat responses adhere to predefined guidelines, improving accuracy and relevance.\n* **Improved User Experience:** Streamlines the interaction with AI features in VS Code, making them more powerful and user-friendly.\n* **Better Customization:** Fully leverages the intended functionality of `.instructions.md` files for tailored AI assistance.","closed_by":{"login":"aeschli","id":6461412,"node_id":"MDQ6VXNlcjY0NjE0MTI=","avatar_url":"https://avatars.githubusercontent.com/u/6461412?v=4","gravatar_id":"","url":"https://api.github.com/users/aeschli","html_url":"https://github.com/aeschli","followers_url":"https://api.github.com/users/aeschli/followers","following_url":"https://api.github.com/users/aeschli/following{/other_user}","gists_url":"https://api.github.com/users/aeschli/gists{/gist_id}","starred_url":"https://api.github.com/users/aeschli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aeschli/subscriptions","organizations_url":"https://api.github.com/users/aeschli/orgs","repos_url":"https://api.github.com/users/aeschli/repos","events_url":"https://api.github.com/users/aeschli/events{/privacy}","received_events_url":"https://api.github.com/users/aeschli/received_events","type":"User","user_view_type":"public","site_admin":true},"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/12770/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/12770/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null},"comments":[]}