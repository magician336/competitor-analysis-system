/followers","following_url":"https://api.github.com/users/digitarald/following{/other_user}","gists_url":"https://api.github.com/users/digitarald/gists{/gist_id}","starred_url":"https://api.github.com/users/digitarald/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/digitarald/subscriptions","organizations_url":"https://api.github.com/users/digitarald/orgs","repos_url":"https://api.github.com/users/digitarald/repos","events_url":"https://api.github.com/users/digitarald/events{/privacy}","received_events_url":"https://api.github.com/users/digitarald/received_events","type":"User","user_view_type":"public","site_admin":true}],"milestone":null,"comments":1,"created_at":"2025-04-26T11:41:05Z","updated_at":"2025-12-12T22:24:27Z","closed_at":"2025-12-12T22:24:27Z","assignee":{"login":"digitarald","id":8599,"node_id":"MDQ6VXNlcjg1OTk=","avatar_url":"https://avatars.githubusercontent.com/u/8599?v=4","gravatar_id":"","url":"https://api.github.com/users/digitarald","html_url":"https://github.com/digitarald","followers_url":"https://api.github.com/users/digitarald/followers","following_url":"https://api.github.com/users/digitarald/following{/other_user}","gists_url":"https://api.github.com/users/digitarald/gists{/gist_id}","starred_url":"https://api.github.com/users/digitarald/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/digitarald/subscriptions","organizations_url":"https://api.github.com/users/digitarald/orgs","repos_url":"https://api.github.com/users/digitarald/repos","events_url":"https://api.github.com/users/digitarald/events{/privacy}","received_events_url":"https://api.github.com/users/digitarald/received_events","type":"User","user_view_type":"public","site_admin":true},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"When batch processing various configuration templates in Agent mode, I frequently receive the following prompt and am forced to stop:\n\n> \"Sorry, the response matched public code so it was blocked. Please rephrase your prompt.\"\n\nEven though I explicitly stated in the prompt that \"public code is allowed,\" Copilot still flags it as a violation and refuses to generate content.\n\nConfiguration files (YAML/JSON/INI, etc.) for many mainstream software frameworks are inherently highly similar and are typical boilerplate code. These files are well-suited for AI-assisted processing but are frequently misidentified due to \"public code matching.\"\n\nDisabling privacy protection is not an acceptable solution—I only want to relax restrictions in this specific scenario without compromising overall [privacy settings](https://docs.github.com/en/copilot/managing-copilot/managing-copilot-as-an-individual-subscriber/managing-your-copilot-plan/managing-copilot-policies-as-an-individual-subscriber#enabling-or-disabling-suggestions-matching-public-code).\n\nSo, is it possible to achieve the following without adjusting Copilot Privacy options:\n• Optimize public code detection rules to recognize and allow common boilerplate content in configuration files;\n• Or provide a fine-grained whitelist/context switch, allowing users to temporarily permit public code output when working with configuration files while maintaining protection in other scenarios.","closed_by":{"login":"dmitrivMS","id":9581278,"node_id":"MDQ6VXNlcjk1ODEyNzg=","avatar_url":"https://avatars.githubusercontent.com/u/9581278?v=4","gravatar_id":"","url":"https://api.github.com/users/dmitrivMS","html_url":"https://github.com/dmitrivMS","followers_url":"https://api.github.com/users/dmitrivMS/followers","following_url":"https://api.github.com/users/dmitrivMS/following{/other_user}","gists_url":"https://api.github.com/users/dmitrivMS/gists{/gist_id}","starred_url":"https://api.github.com/users/dmitrivMS/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmitrivMS/subscriptions","organizations_url":"https://api.github.com/users/dmitrivMS/orgs","repos_url":"https://api.github.com/users/dmitrivMS/repos","events_url":"https://api.github.com/users/dmitrivMS/events{/privacy}","received_events_url":"https://api.github.com/users/dmitrivMS/received_events","type":"User","user_view_type":"public","site_admin":true},"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/8627/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/8627/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null},"comments":[]}