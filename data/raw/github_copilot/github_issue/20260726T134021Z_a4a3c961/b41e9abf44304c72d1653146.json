github.com/users/lfazliev/gists{/gist_id}","starred_url":"https://api.github.com/users/lfazliev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lfazliev/subscriptions","organizations_url":"https://api.github.com/users/lfazliev/orgs","repos_url":"https://api.github.com/users/lfazliev/repos","events_url":"https://api.github.com/users/lfazliev/events{/privacy}","received_events_url":"https://api.github.com/users/lfazliev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-17T12:40:01Z","updated_at":"2025-03-17T12:40:01Z","body":"> Hi thanks for filing this issue. Could you please add the details as to the exact request and response so we can assist you better?\n\nIn code fix mode, copilot returned a response in the window, but in the code editor it just deleted all the code in the specified files instead of making changes. This happened with any language model.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/2729348205/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/2736315148","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/6497#issuecomment-2736315148","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/6497","id":2736315148,"node_id":"IC_kwDOJYd5Dc6jGNsM","user":{"login":"lfazliev","id":72712408,"node_id":"MDQ6VXNlcjcyNzEyNDA4","avatar_url":"https://avatars.githubusercontent.com/u/72712408?v=4","gravatar_id":"","url":"https://api.github.com/users/lfazliev","html_url":"https://github.com/lfazliev","followers_url":"https://api.github.com/users/lfazliev/followers","following_url":"https://api.github.com/users/lfazliev/following{/other_user}","gists_url":"https://api.github.com/users/lfazliev/gists{/gist_id}","starred_url":"https://api.github.com/users/lfazliev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lfazliev/subscriptions","organizations_url":"https://api.github.com/users/lfazliev/orgs","repos_url":"https://api.github.com/users/lfazliev/repos","events_url":"https://api.github.com/users/lfazliev/events{/privacy}","received_events_url":"https://api.github.com/users/lfazliev/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-19T11:36:13Z","updated_at":"2025-03-19T11:36:13Z","body":"> Hi thanks for filing this issue. Could you please add the details as to the exact request and response so we can assist you better?\n\nHere's what it looks like, for any fix request, on any language model.\n\n![Image](https://github.com/user-attachments/assets/bcdb605e-e109-49cb-a2c6-04b6a646a17c)\n\n![Image](https://github.com/user-attachments/assets/2420270a-0284-411e-81b4-9eae2b16155c)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/2736315148/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/2815876766","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/6497#issuecomment-2815876766","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/6497","id":2815876766,"node_id":"IC_kwDOJYd5Dc6n1t6e","user":{"login":"TheComputerGenie","id":21057518,"node_id":"MDQ6VXNlcjIxMDU3NTE4","avatar_url":"https://avatars.githubusercontent.com/u/21057518?v=4","gravatar_id":"","url":"https://api.github.com/users/TheComputerGenie","html_url":"https://github.com/TheComputerGenie","followers_url":"https://api.github.com/users/TheComputerGenie/followers","following_url":"https://api.github.com/users/TheComputerGenie/following{/other_user}","gists_url":"https://api.github.com/users/TheComputerGenie/gists{/gist_id}","starred_url":"https://api.github.com/users/TheComputerGenie/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TheComputerGenie/subscriptions","organizations_url":"https://api.github.com/users/TheComputerGenie/orgs","repos_url":"https://api.github.com/users/TheComputerGenie/repos","events_url":"https://api.github.com/users/TheComputerGenie/events{/privacy}","received_events_url":"https://api.github.com/users/TheComputerGenie/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-18T17:17:20Z","updated_at":"2025-04-18T17:17:20Z","body":"> This happened with any language model.\n\nBecause in every instance the language model isn't actually used. Rather than leverage the actual power of LLMs, Microsoft has decided to have Copilot use standard string replace tools. This is why it usually cannot replace the lost code because it thinks it only did what the \"logic\" says would have been found by the string replace tools.\n\nThe best advice I've been given is to ensure you store/commit before each new use of Copilot and _never_ think of it as an LLM or AI, but an extension of tools","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/2815876766/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3194457723","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/6497#issuecomment-3194457723","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/6497","id":3194457723,"node_id":"IC_kwDOJYd5Dc6-Z457","user":{"login":"vs-code-engineering[bot]","id":122617