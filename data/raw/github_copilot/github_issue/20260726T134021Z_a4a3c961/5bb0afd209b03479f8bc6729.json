on\n\nIdeas.\n\n- Allow a \"minInactivityTimeMs\" to prevent it from _going nuts\" and putting slop all over my screen\n- Allow a minor nudge to hint that NES is ready, but without thrashing my current editor and showing an inline preview\n","closed_by":{"login":"benibenj","id":44439583,"node_id":"MDQ6VXNlcjQ0NDM5NTgz","avatar_url":"https://avatars.githubusercontent.com/u/44439583?v=4","gravatar_id":"","url":"https://api.github.com/users/benibenj","html_url":"https://github.com/benibenj","followers_url":"https://api.github.com/users/benibenj/followers","following_url":"https://api.github.com/users/benibenj/following{/other_user}","gists_url":"https://api.github.com/users/benibenj/gists{/gist_id}","starred_url":"https://api.github.com/users/benibenj/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/benibenj/subscriptions","organizations_url":"https://api.github.com/users/benibenj/orgs","repos_url":"https://api.github.com/users/benibenj/repos","events_url":"https://api.github.com/users/benibenj/events{/privacy}","received_events_url":"https://api.github.com/users/benibenj/received_events","type":"User","user_view_type":"public","site_admin":true},"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/8495/reactions","total_count":20,"+1":18,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/8495/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null},"comments":[{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/2831318807","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/8495#issuecomment-2831318807","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/8495","id":2831318807,"node_id":"IC_kwDOJYd5Dc6own8X","user":{"login":"bamurtaugh","id":25310137,"node_id":"MDQ6VXNlcjI1MzEwMTM3","avata