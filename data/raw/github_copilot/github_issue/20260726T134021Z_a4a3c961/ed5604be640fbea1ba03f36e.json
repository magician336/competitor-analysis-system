gnees":[{"login":"mjbvz","id":12821956,"node_id":"MDQ6VXNlcjEyODIxOTU2","avatar_url":"https://avatars.githubusercontent.com/u/12821956?v=4","gravatar_id":"","url":"https://api.github.com/users/mjbvz","html_url":"https://github.com/mjbvz","followers_url":"https://api.github.com/users/mjbvz/followers","following_url":"https://api.github.com/users/mjbvz/following{/other_user}","gists_url":"https://api.github.com/users/mjbvz/gists{/gist_id}","starred_url":"https://api.github.com/users/mjbvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mjbvz/subscriptions","organizations_url":"https://api.github.com/users/mjbvz/orgs","repos_url":"https://api.github.com/users/mjbvz/repos","events_url":"https://api.github.com/users/mjbvz/events{/privacy}","received_events_url":"https://api.github.com/users/mjbvz/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":3,"created_at":"2025-04-07T02:44:12Z","updated_at":"2025-12-12T20:33:19Z","closed_at":"2025-12-12T20:33:19Z","assignee":{"login":"mjbvz","id":12821956,"node_id":"MDQ6VXNlcjEyODIxOTU2","avatar_url":"https://avatars.githubusercontent.com/u/12821956?v=4","gravatar_id":"","url":"https://api.github.com/users/mjbvz","html_url":"https://github.com/mjbvz","followers_url":"https://api.github.com/users/mjbvz/followers","following_url":"https://api.github.com/users/mjbvz/following{/other_user}","gists_url":"https://api.github.com/users/mjbvz/gists{/gist_id}","starred_url":"https://api.github.com/users/mjbvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mjbvz/subscriptions","organizations_url":"https://api.github.com/users/mjbvz/orgs","repos_url":"https://api.github.com/users/mjbvz/repos","events_url":"https://api.github.com/users/mjbvz/events{/privacy}","received_events_url":"https://api.github.com/users/mjbvz/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I have an issue with the GitHub Copilot plugin in a Vagrant project I'm working on. This issue started after my plugin updated on 4-6-2025. The issue that I'm having is that when I do vagrant up on my host and create the systems, vagrant is putting the .vagrant folder in my project folder. Github Copilot is then locking the vhdx files so when I later try to do vagrant destroy followed by vagrant up, the files never get released and the vagrant up command fails because the hard drive files never actually got removed during vagrant destroy. \n\nI have verified that it is definitely the Github copilot plugin that is causing my issue. I disabled all extensions and turned each one on individually. No other extensions locked the vhdx files when they were enabled. After enabling the Github copilot plugin, the file is locked pretty immediately.\n\n- GitHub Copilot Extension Version: 1.296.0\n- VS Code Version: 1.99.0\n- OS Version: 10.0.26100\n- Logs: Nothing appears in logs\n\nSteps to Reproduce:\n\n1. Open project that has vagrant project\n2. Run vagrant up. After this, the vhdx files are locked by Github copilot. \n3. Run vagrant destroy. The virtual machines are removed from the system and everything, but the vhdx files that normally are removed after vagrant destroy don't go away.\n4. On the next vagrant up, the command fails because it can't copy the vhdx to the location because the locked file is still there. \n\nRemediation:\n\n1. After running vagrant destroy, I have to close out VS Code. After that, the locks are broken and the file delete occurs normally. This is a pain when I'm trying to test out a configuration and bring the systems up and down repeatedly.\n2. Disable Github copilot plugin. This completely solves the issue, but obviously I'd prefer to be able to use the plugin. \n","closed_by":{"login":"mjbvz","id":12821956,"node_id":"MDQ6VXNlcjEyODIxOTU2","avatar_url":"https://avatars.githubusercontent.com/u/12821956?v=4","gravatar_id":"","url":"https://api.github.com/users/mjbvz","html_url":"https://github.com/mjbvz","followers_url":"https://api.github.com/users/mjbvz/followers","following_url":"https://api.github.com/users/mjbvz/following{/other_user}","gists_url":"https://api.github.com/users/mjbvz/gists{/gist_id}","starred_url":"https://api.github.com/users/mjbvz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mjbvz/subscriptions","organizations_url":"https://api.github.com/users/mjbvz/orgs","repos_url":"https://api.github.com/users/mjbvz/repos","events_url":"https://api.github.com/users/mjbvz/events{/privacy}","received_events_url":"https://api.github.com/users/mjbvz/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/7387/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/7387/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null},"comments":[{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/2784924870","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/7387#issuecomment-2784924870","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/7387","id":2784924870,"node_id":"IC_kwDOJYd5Dc6l_pTG","user":{"login":"bhavyaus","id":25044782,"node_id":"MDQ6VXNlcjI1MDQ0Nzgy","avatar_url":"https://avatars.githubusercontent.com/u/25044782?v=4","gravatar_id":"","url":"https://api.github.com/users/bhavyaus","html_url":"https://github.com/bhavyaus","followers_url":"https://api.github.com/users/bhavyaus/followers","following_u