1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3375225031","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/13039#issuecomment-3375225031","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/13039","id":3375225031,"node_id":"IC_kwDOJYd5Dc7JLdjH","user":{"login":"TimeLordRaps","id":123702776,"node_id":"U_kgDOB1-N-A","avatar_url":"https://avatars.githubusercontent.com/u/123702776?v=4","gravatar_id":"","url":"https://api.github.com/users/TimeLordRaps","html_url":"https://github.com/TimeLordRaps","followers_url":"https://api.github.com/users/TimeLordRaps/followers","following_url":"https://api.github.com/users/TimeLordRaps/following{/other_user}","gists_url":"https://api.github.com/users/TimeLordRaps/gists{/gist_id}","starred_url":"https://api.github.com/users/TimeLordRaps/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TimeLordRaps/subscriptions","organizations_url":"https://api.github.com/users/TimeLordRaps/orgs","repos_url":"https://api.github.com/users/TimeLordRaps/repos","events_url":"https://api.github.com/users/TimeLordRaps/events{/privacy}","received_events_url":"https://api.github.com/users/TimeLordRaps/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-07T05:07:27Z","updated_at":"2025-10-07T05:07:27Z","body":"The fact that I've paid over $100 for this service since its inception and this has been a consistent problem regardless of the massive amount of documented examples of it, is infuriating beyond belief, this needs to be priority number one before any other features are added or other bugs are fixed in my opinion it should've been fixed when sonnet was a wee 3.5  The whole point of agent is autonomy yet I cant leave it for a second without it running a command in a new terminal, polluting my base python environment or default python environment, failing to realize a server is running in a previous terminal it used, despite this being a 1st year student mistake/awareness of how terminals work. Not only that but then forcing away from command prompt because it lacks shell integration to use powershell, when all the models assume bash just added to the time wasted on this problem. This along with all other terminal related issues should be pinned issues until this is resolved.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3375225031/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3375240243","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/13039#issuecomment-3375240243","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/13039","id":3375240243,"node_id":"IC_kwDOJYd5Dc7JLhQz","user":{"login":"TimeLordRaps","id":123702776,"node_id":"U_kgDOB1-N-A","avatar_url":"https://avatars.githubusercontent.com/u/123702776?v=4","gravatar_id":"","url":"https://api.github.com/users/TimeLordRaps","html_url":"https://github.com/TimeLordRaps","followers_url":"https://api.github.com/users/TimeLordRaps/followers","following_url":"https://api.github.com/users/TimeLordRaps/following{/other_user}","gists_url":"https://api.github.com/users/TimeLordRaps/gists{/gist_id}","starred_url":"https://api.github.com/users/TimeLordRaps/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TimeLordRaps/subscriptions","organizations_url":"https://api.github.com/users/TimeLordRaps/orgs","repos_url":"https://api.github.com/users/TimeLordRaps/repos","events_url":"https://api.github.com/users/TimeLordRaps/events{/privacy}","received_events_url":"https://api.github.com/users/TimeLordRaps/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-07T05:15:32Z","updated_at":"2025-10-07T05:15:32Z","body":"after berating claude sonnet4.5 on this issue relentlessly, I realized it had been setting the parameter of its run_in_terminal command called isBackground=True, which would cause the multiple terminal mess, there should be inherent mention of this in the tool description, where it is advised to almost never run_in_terminal tool calls with isBackground=True, unless it is 1. aware this starts a new terminal and 2. would need to resetup the new background terminal to the current working environment ie python/conda/mamba env, directory, and any other possible environment variables that would be needed in a fresh terminal. This seems like a lack of clear documentation on the tools description. So it's a prompt-level bug, as opposed to a code-level bug.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3375240243/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3476852899","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/13039#issuecomment-3476852899","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/13039","id":3476852899,"node_id":"IC_kwDOJYd5Dc7PPJCj","user":{"login":"Tyriar","id":2193314,"node_id":"MDQ6VXNlcjIxOTMzMTQ=","avatar_url":"https://avatars.githubusercontent.com/u/2193314?v=4","gravatar_id":"","url":"https://api.github.com/users/Tyriar","html_url":"https://github.com/Tyriar","followers_url":"https://api.github.com/users/Tyriar/followers","following_url":"https://api.github.com/users/Tyriar/following{/other_user}",