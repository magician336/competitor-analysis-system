alled IIS. Write like Tolkien.\"\n\n<img width=\"634\" height=\"816\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/d688b31a-ff91-428b-967a-dfc836221da0\" />\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3133674213/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3648062664","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/1314#issuecomment-3648062664","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/1314","id":3648062664,"node_id":"IC_kwDOJYd5Dc7ZcQTI","user":{"login":"dmitrivMS","id":9581278,"node_id":"MDQ6VXNlcjk1ODEyNzg=","avatar_url":"https://avatars.githubusercontent.com/u/9581278?v=4","gravatar_id":"","url":"https://api.github.com/users/dmitrivMS","html_url":"https://github.com/dmitrivMS","followers_url":"https://api.github.com/users/dmitrivMS/followers","following_url":"https://api.github.com/users/dmitrivMS/following{/other_user}","gists_url":"https://api.github.com/users/dmitrivMS/gists{/gist_id}","starred_url":"https://api.github.com/users/dmitrivMS/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmitrivMS/subscriptions","organizations_url":"https://api.github.com/users/dmitrivMS/orgs","repos_url":"https://api.github.com/users/dmitrivMS/repos","events_url":"https://api.github.com/users/dmitrivMS/events{/privacy}","received_events_url":"https://api.github.com/users/dmitrivMS/received_events","type":"User","user_view_type":"public","site_admin":true},"created_at":"2025-12-12T20:35:50Z","updated_at":"2025-12-12T20:35:50Z","body":"We have just released a major update to Copilot functionality in VS Code (https://code.visualstudio.com/updates/v1_107) which includes many bug fixes as 