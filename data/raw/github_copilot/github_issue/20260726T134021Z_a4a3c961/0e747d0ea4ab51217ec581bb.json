itarald","html_url":"https://github.com/digitarald","followers_url":"https://api.github.com/users/digitarald/followers","following_url":"https://api.github.com/users/digitarald/following{/other_user}","gists_url":"https://api.github.com/users/digitarald/gists{/gist_id}","starred_url":"https://api.github.com/users/digitarald/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/digitarald/subscriptions","organizations_url":"https://api.github.com/users/digitarald/orgs","repos_url":"https://api.github.com/users/digitarald/repos","events_url":"https://api.github.com/users/digitarald/events{/privacy}","received_events_url":"https://api.github.com/users/digitarald/received_events","type":"User","user_view_type":"public","site_admin":true}],"milestone":null,"comments":7,"created_at":"2024-06-19T00:55:26Z","updated_at":"2025-12-12T20:35:50Z","closed_at":"2025-12-12T20:35:50Z","assignee":{"login":"digitarald","id":8599,"node_id":"MDQ6VXNlcjg1OTk=","avatar_url":"https://avatars.githubusercontent.com/u/8599?v=4","gravatar_id":"","url":"https://api.github.com/users/digitarald","html_url":"https://github.com/digitarald","followers_url":"https://api.github.com/users/digitarald/followers","following_url":"https://api.github.com/users/digitarald/following{/other_user}","gists_url":"https://api.github.com/users/digitarald/gists{/gist_id}","starred_url":"https://api.github.com/users/digitarald/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/digitarald/subscriptions","organizations_url":"https://api.github.com/users/digitarald/orgs","repos_url":"https://api.github.com/users/digitarald/repos","events_url":"https://api.github.com/users/digitarald/events{/privacy}","received_events_url":"https://api.github.com/users/digitarald/received_events","type":"User","user_view_type":"public","site_admin":true},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"perce