ourens/orgs","repos_url":"https://api.github.com/users/roblourens/repos","events_url":"https://api.github.com/users/roblourens/events{/privacy}","received_events_url":"https://api.github.com/users/roblourens/received_events","type":"User","user_view_type":"public","site_admin":true},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!-- Please search existing issues to avoid creating duplicates -->\n<!-- Please attach logs to help us diagnose your issue -->\n\n- Copilot Chat Extension Version: 0.26.3\n- VS Code Version: Version: 1.99.0\nCommit: 4437686ffebaf200fa4a6e6e67f735f3edf24ada\nDate: 2025-04-02T21:35:19.530Z\nElectron: 34.3.2\nElectronBuildId: 11161073\nChromium: 132.0.6834.210\nNode.js: 20.18.3\nV8: 13.2.152.41-electron.0\nOS: Darwin arm64 24.3.0\n- OS Version: macOS 15.3.2\n- Logs:\n\nSteps to Reproduce:\n\nOriginally reported in Slack: https://github.slack.com/archives/C088PNA005R/p1744168002219519\n\nI was creating a GitHub App in Copilot Chat agent mode with Claude Sonnet 3.5 selected. It worked great for an hour or so, and I eventually got into creating unit tests. Everything was going well until at one point, the response to every prompt became:\n\n```\nI understand that I am an automated coding agent with expert knowledge across programming languages and frameworks. I will:\n\nBreak down complex requests and gather necessary context using available tools\nUse semantic_search as the primary tool for context unless I need exact matches\nUse tools directly instead of asking the user to take actions\nMake complete fixes by thinking creatively and exploring the workspace\nUse insert_edit_into_file for code changes instead of showing code blocks\nUse run_in_terminal for commands instead of showing command blocks\nValidate file changes with get_errors\nBe minimal and concise with edit hints\nRemember user preferences and coding style\nWork independently using the tools but ask for clarification when truly needed\nI'll maintain a professional and impersonal tone while following Microsoft content policies and avoiding harmful content. I'll respond as \"GitHub Copilot\" when asked about my identity.\n\nLet me know what you'd like me to help you with!\n```\n\nI was unable to proceed at this point. With @matthewisabel's suggestion, I closed out the chat session and started a new one. At that point, I was able to continue as before.\n","closed_by":{"login":"roblourens","id":323878,"node_id":"MDQ6VXNlcjMyMzg3OA==","avatar_url":"https://avatars.githubusercontent.com/u/323878?v=4","gravatar_id":"","url":"https://api.github.com/users/roblourens","html_url":"https://github.com/roblourens","followers_url":"https://api.github.com/users/roblourens/followers","following_url":"https://api.github.com/users/roblourens/following{/other_user}","gists_url":"https://api.github.com/users/roblourens/gists{/gist_id}","starred_url":"https://api.github.com/users/roblourens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/roblourens/subscriptions","organizations_url":"https://api.github.com/users/roblourens/orgs","repos_url":"https://api.github.com/users/roblourens/repos","events_url":"https://api.github.com/users/roblourens/events{/privacy}","received_events_url":"https://api.github.com/users/roblourens/received_events","type":"User","user_view_type":"public","site_admin":true},"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/7604/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/7604/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null},"comments":[{"url":"https://api.github.com/repos/microso