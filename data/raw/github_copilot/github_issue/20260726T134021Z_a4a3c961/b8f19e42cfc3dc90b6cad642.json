 from time to time after agent execution. \n\nSometimes the typescript server keeps showing errors of deleted files; restarting the typescript server does not solve the problem\n\nSometimes the files are recreated empty in the filesystem after additional agent execution.\n\n- both vscode insiders and latest stable releases;\n- OS running vscode: windows 10 with remote ssh on a ubuntu 25.04\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3031160644/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/comments/3041199620","html_url":"https://github.com/microsoft/vscode-copilot-release/issues/12725#issuecomment-3041199620","issue_url":"https://api.github.com/repos/microsoft/vscode-copilot-release/issues/12725","id":3041199620,"node_id":"IC_kwDOJYd5Dc61RQYE","user":{"login":"burner1024","id":1279852,"node_id":"MDQ6VXNlcjEyNzk4NTI=","avatar_url":"https://avatars.githubusercontent.com/u/1279852?v=4","gravatar_id":"","url":"https://api.github.com/users/burner1024","html_url":"https://github.com/burner1024","followers_url":"https://api.github.com/users/burner1024/followers","following_url":"https://api.github.com/users/burner1024/following{/other_user}","gists_url":"https://api.github.com/users/burner1024/gists{/gist_id}","starred_url":"https://api.github.com/users/burner1024/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/burner1024/subscriptions","organizations_url":"https://api.github.com/users/burner1024/orgs","repos_url":"https://api.github.com/users/burner1024/repos","events_url":"https://api.github.com/users/burner1024/events{/privacy}","received_events_url":"https://api.github.com/users/burner1024/received_events","type":"User","user_view_type":"public","site_admin":false},