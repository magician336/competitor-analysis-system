# Local environment and secrets
.venv/
.env

# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.cache/
.benchmark-build/

# Runtime output
logs/
data/raw/*
data/cleaned/documents.jsonl
data/cleaned/archive/
data/snapshots/*
data/runtime/*

# Keep directory placeholders and committed samples
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/snapshots/.gitkeep
!data/runtime/.gitkeep

docs/*
!docs/*.md
!docs/.gitkeep
