# Local environment and secrets
.venv/
.env

# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.cache/
.benchmark-build/

# Runtime output
logs/
data/raw/*
data/cleaned/documents.jsonl
data/cleaned/documents.jsonl.lock
data/cleaned/backups/
data/cleaned/archive/
data/snapshots/*
data/runtime/*
# Versioned demo database: freezes the homepage cards and capability snapshots
# used for the shared local demonstration.
!data/runtime/coderadar.db

# Keep directory placeholders and committed samples
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/snapshots/.gitkeep
!data/runtime/.gitkeep

docs/*
!docs/*.md
!docs/.gitkeep
.tokensave/
_verify_result.txt
