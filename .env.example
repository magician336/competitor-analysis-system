# =============================================================================
# CodeRadar 环境配置
# 复制此文件为 .env 并按需修改：cp .env.example .env
# docker-compose.yml 自动从 .env 读取这些变量
# =============================================================================

# ── GitHub ──────────────────────────────────────────────────────────────────
# 用于 GitHub Release / Issue 采集。（只读、细粒度 token 即可）
GITHUB_TOKEN=

# ── 网络代理（可选）─────────────────────────────────────────────────────────
# Python requests 自动读取这些代理变量
# HTTPS_PROXY=
# HTTP_PROXY=

# ── 数据路径 ─────────────────────────────────────────────────────────────────
# 相对路径始终以项目根目录为基准，本地、IDE 与 Docker Compose 可共用。
# 不要在此写 /app/CodeRadar、盘符或某台机器的用户目录。
CODERADAR_DATABASE_URL=sqlite:///data/runtime/coderadar.db
MINIRAG_DOCUMENTS_PATH=data/cleaned/documents.jsonl
MINIRAG_EVALUATION_PATH=data/samples/测试数据集.csv
MINIRAG_TRACE_PATH=data/runtime/retrieval_traces.jsonl
MINIRAG_MODEL_CACHE_DIR=.cache/models

# ── Mini-RAG Profile（★ 一键切换配置集）───────────────────────────────────
# 通过一个变量即可切换整套 Mini-RAG 配置，无需分别设置 Embedding/Reranker。
#
# default → config/mini_rag.yaml
#   - 嵌入: hash（离线确定性，无外部依赖）
#   - 重排序: lexical（词法重叠）
#   适合开发、测试、无需模型依赖的环境。
#
# formal  → config/mini_rag.formal.yaml
#   - 嵌入: sentence_transformers（BGE-M3 多语言嵌入）
#   - 重排序: cross_encoder（Cross-Encoder 模型）
#   适合正式检索与评测。需要设置 MINIRAG_INSTALL_ML=true 安装模型依赖，
#   且首次运行会自动下载模型权重（约 2GB）。
#
# 切换 profile 后必须执行全量索引重建：
#   docker compose exec api python -m scripts.build_index
MINIRAG_PROFILE=default

# ── ML 依赖安装（构建时参数）───────────────────────────────────────────────
# 使用 sentence_transformers 嵌入或 cross_encoder 重排序时需要设为 true。
# 修改后需重新构建镜像：docker compose up -d --build
MINIRAG_INSTALL_ML=false

# ── 高级微调（可选）─────────────────────────────────────────────────────────
# 以下变量可单独覆盖 profile 已选 YAML 中的对应值。
# 取消注释并设置后，将覆盖 YAML 文件中的配置。
# 显式路径会覆盖 MINIRAG_PROFILE；通常保持注释，仅用 profile 切换。
# MINIRAG_CONFIG_PATH=config/mini_rag.yaml
# MINIRAG_EMBEDDING_PROVIDER=hash
# MINIRAG_EMBEDDING_MODEL=BAAI/bge-m3
# MINIRAG_EMBEDDING_DIMENSION=1024
# MINIRAG_RERANKER_PROVIDER=lexical
# MINIRAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# MINIRAG_RERANKER_STRICT=false

# ── Elasticsearch ────────────────────────────────────────────────────────────
# ES 索引前缀与读别名（仅 scripts/build_index.py 使用，compose 内 ES URL 固定）
MINIRAG_INDEX_PREFIX=coderadar_chunks
MINIRAG_READ_ALIAS=coderadar_chunks_current

# ── LangChain Agent ─────────────────────────────────────────────────────────
# rules  = 离线确定性基线（推荐测试/快照，无模型依赖）
# llm    = 使用 DeepSeek 模型；失败时回退到 rules
# hybrid = 证据优先链 + LLM 独立润色/标签（推荐在线模式）
CODERADAR_AGENT_MODE=rules

# ── DeepSeek LLM 配置（仅 AGENT_MODE=llm/hybrid 时需填写）─────────────────
CODERADAR_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CODERADAR_LLM_TIMEOUT_SECONDS=45
CODERADAR_LLM_MAX_TOKENS=4096
CODERADAR_LLM_MAX_RETRIES=2

# ── API 认证与限流 ──────────────────────────────────────────────────────────
CODERADAR_AUTH_ENABLED=true
# 生成一个足够长的随机字符串（至少 32 字符），不要提交到版本控制
CODERADAR_API_KEY=
CODERADAR_READ_RATE_PER_MINUTE=120
CODERADAR_WRITE_RATE_PER_MINUTE=30

# ── 端口 ────────────────────────────────────────────────────────────────────
# CODERADAR_API_PORT 仅用于容器外直接访问 API（调试用），
# 生产流量统一走前端 nginx 反向代理。
CODERADAR_API_PORT=8001
CODERADAR_UI_PORT=8080

# ── 前端 CORS ───────────────────────────────────────────────────────────────
# 当部署后前端域名变化时需要同步修改
CODERADAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ── Worker 异步工作流 ──────────────────────────────────────────────────────
# 单实例 Worker 运行时参数（一般无需修改）
CODERADAR_WORKFLOW_POLL_SECONDS=1
CODERADAR_WORKFLOW_LEASE_SECONDS=30
CODERADAR_WORKFLOW_HEARTBEAT_SECONDS=10
CODERADAR_WORKFLOW_TIMEOUT_SECONDS=300
