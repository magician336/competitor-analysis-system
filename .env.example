# Copy this file to .env and keep the real token local.
# Create a read-only fine-grained token for public GitHub repositories.
GITHUB_TOKEN=

# requests automatically reads these proxy variables when configured.
# HTTPS_PROXY=
# HTTP_PROXY=

# Mini-RAG data and Elasticsearch
MINIRAG_DOCUMENTS_PATH=data/cleaned/documents.jsonl
MINIRAG_ELASTICSEARCH_URL=http://localhost:9200
MINIRAG_INDEX_PREFIX=coderadar_chunks
MINIRAG_READ_ALIAS=coderadar_chunks_current

# Use "hash" for a dependency-free deterministic smoke-test baseline.
# Use "sentence_transformers" for the configured multilingual model.
# Set this build argument to true before building the Docker ML image.
MINIRAG_INSTALL_ML=false
MINIRAG_EMBEDDING_PROVIDER=hash
MINIRAG_EMBEDDING_MODEL=BAAI/bge-m3
MINIRAG_EMBEDDING_DIMENSION=1024
MINIRAG_RERANKER_PROVIDER=lexical
MINIRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MINIRAG_RERANKER_STRICT=false
MINIRAG_MODEL_CACHE_DIR=.cache/models

# Service and trace storage
MINIRAG_CONFIG_PATH=config/mini_rag.yaml
MINIRAG_TRACE_PATH=data/runtime/retrieval_traces.jsonl

# Week-three LangChain Agent analysis.
# rules  = deterministic/offline baseline (recommended for tests and snapshots)
# llm    = LangChain ChatDeepSeek structured output; failures degrade to rules
# hybrid = same evidence-first chain with an independent LLM drafting/tagging pass
CODERADAR_AGENT_MODE=rules
CODERADAR_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat supports the structured-output path used by this project.
DEEPSEEK_MODEL=deepseek-chat
CODERADAR_LLM_TIMEOUT_SECONDS=45
CODERADAR_LLM_MAX_TOKENS=1600
CODERADAR_LLM_MAX_RETRIES=2

# Formal API authentication and browser access (phase three).
# Generate a long random value for real deployments; never commit the real key.
CODERADAR_AUTH_ENABLED=true
CODERADAR_API_KEY=
CODERADAR_READ_RATE_PER_MINUTE=120
CODERADAR_WRITE_RATE_PER_MINUTE=30
CODERADAR_CORS_ORIGINS=http://localhost:5173
