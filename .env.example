# Anthropic Claude API 配置
# 严禁在业务代码中硬编码 API 密钥，统一从此处读取
ANTHROPIC_API_KEY=sk-ant-你的ClaudeAPI密钥

# 若使用中转平台，取消下一行注释并填写地址；否则保持注释使用官方地址
# ANTHROPIC_BASE_URL=https://你的中转地址

# 模型名称配置（按课件模型分层调用规范）
MODEL_HAIKU=claude-3-5-haiku-20241022
MODEL_SONNET=claude-3-7-sonnet-20250219
MODEL_OPUS=claude-3-opus-20240229

# FastAPI 服务配置
APP_HOST=127.0.0.1
APP_PORT=8000
